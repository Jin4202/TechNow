{
  "name": "technow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:secrets",
    "db:types": "supabase gen types typescript --local > src/db/types.ts",
    "db:reset": "supabase db reset",
    "feeds:live": "vitest run --config vitest.live.config.mts",
    "db:live": "vitest run --config vitest.live.config.mts tests/live/seen-items.live.ts",
    "daily:live": "vitest run --config vitest.live.config.mts tests/live/run-daily.live.ts",
    "seed": "vitest run --config vitest.live.config.mts tests/live/seed.live.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@trigger.dev/sdk": "^4.5.16",
    "fast-xml-parser": "^5.11.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.0.0"
  }
}
