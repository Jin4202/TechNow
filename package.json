{
  "name": "technow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:secrets",
    "db:types": "supabase gen types typescript --local > src/db/types.ts",
    "db:reset": "supabase db reset",
    "feeds:live": "vitest run --config vitest.live.config.mts",
    "db:live": "vitest run --config vitest.live.config.mts tests/live/seen-items.live.ts",
    "daily:live": "vitest run --config vitest.live.config.mts tests/live/run-daily.live.ts",
    "group:live": "vitest run --config vitest.live.config.mts tests/live/group-topics.live.ts",
    "score:live": "vitest run --config vitest.live.config.mts tests/live/score-topics.live.ts",
    "fetch:live": "vitest run --config vitest.live.config.mts tests/live/fetch-page.live.ts",
    "brave:live": "vitest run --config vitest.live.config.mts tests/live/brave.live.ts",
    "research:live": "vitest run --config vitest.live.config.mts tests/live/research.live.ts",
    "fixtures:build": "vitest run --config vitest.live.config.mts tests/live/build-fixtures.live.ts",
    "write:live": "vitest run --config vitest.live.config.mts tests/live/write-article.live.ts",
    "verify:live": "vitest run --config vitest.live.config.mts tests/live/verify-claims.live.ts",
    "build:live": "vitest run --config vitest.live.config.mts tests/live/build-article.live.ts",
    "articles:export": "vitest run --config vitest.live.config.mts tests/live/export-articles.live.ts",
    "reference:build": "vitest run --config vitest.live.config.mts tests/live/build-reference.live.ts",
    "evaluate": "vitest run --config vitest.live.config.mts tests/live/evaluate.live.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@mozilla/readability": "^0.6.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@trigger.dev/sdk": "^4.5.16",
    "fast-xml-parser": "^5.11.1",
    "linkedom": "^0.18.13",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.0.0"
  }
}
