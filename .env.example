# ═══════════════════════════════════════════════════════════════════════
#  Next.js 앱 — Vercel 환경변수에 등록한다
# ═══════════════════════════════════════════════════════════════════════

# Supabase. anon 키는 브라우저에 공개되며, RLS가 유일한 방어선이다 (D-02)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 접근 게이트. Phase 7(7.7)에서 제거한다
GATE_USER=
GATE_PASSWORD=


# ═══════════════════════════════════════════════════════════════════════
#  Trigger.dev 파이프라인 전용
#
#  ⚠️ 아래 키는 절대 Vercel / Next.js 환경에 넣지 않는다 (CLAUDE.md §2.1).
#     NEXT_PUBLIC_ 접두사를 붙이는 순간 공개 키가 된다.
#     service_role 키가 앱으로 새면 RLS 방어선이 통째로 무의미해진다.
#
#  로컬에서는 .env.local 에 함께 두어도 되지만, 배포 시에는
#  Trigger.dev 대시보드의 환경변수에만 등록한다.
# ═══════════════════════════════════════════════════════════════════════

SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
BRAVE_API_KEY=
FAL_KEY=
TRIGGER_SECRET_KEY=


# ═══════════════════════════════════════════════════════════════════════
#  선정 튜닝 값 (선택) — 로드맵 2.6
#
#  전부 기본값이 코드에 있고, 여기서 덮어쓸 수 있다.
#  Trigger.dev 환경변수는 재배포 없이 바뀌므로 캘리브레이션(2.8) 중에
#  배포를 기다리지 않아도 된다. 잘못된 값은 무시되고 기본값이 쓰인다.
#
#  값을 바꾸면 docs/RUBRIC.md 의 캘리브레이션 기록에 한 줄 남긴다.
# ═══════════════════════════════════════════════════════════════════════

# TECHNOW_THRESHOLD_TOTAL=10          # 통과 최소 총점 (15점 만점)
# TECHNOW_MIN_AXIS=3                  # 모든 축이 이 값 이상이어야 통과
# TECHNOW_DAILY_CAP=3                 # 하루 발행 상한
# TECHNOW_RESCORE_TOP_N=9             # 재채점할 상위 토픽 수 (D-19)
# TECHNOW_FOLLOW_UP_WINDOW_DAYS=7     # 그룹핑에 넣을 최근 발행 기사 기간
# TECHNOW_PENDING_TTL_DAYS=3          # pending 항목 폐기 기한 (D-01)
# TECHNOW_PROCESSED_RETENTION_DAYS=90 # processed 행 보존 기간
