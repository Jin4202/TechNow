# ═══════════════════════════════════════════════════════════════════════
#  Next.js 앱 — Vercel 환경변수에 등록한다
# ═══════════════════════════════════════════════════════════════════════

# Supabase. anon 키는 브라우저에 공개되며, RLS가 유일한 방어선이다 (D-02)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 접근 게이트. Phase 7(7.7)에서 제거한다
GATE_USER=
GATE_PASSWORD=


# ═══════════════════════════════════════════════════════════════════════
#  Trigger.dev 파이프라인 전용
#
#  ⚠️ 아래 키는 절대 Vercel / Next.js 환경에 넣지 않는다 (CLAUDE.md §2.1).
#     NEXT_PUBLIC_ 접두사를 붙이는 순간 공개 키가 된다.
#     service_role 키가 앱으로 새면 RLS 방어선이 통째로 무의미해진다.
#
#  로컬에서는 .env.local 에 함께 두어도 되지만, 배포 시에는
#  Trigger.dev 대시보드의 환경변수에만 등록한다.
# ═══════════════════════════════════════════════════════════════════════

SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
BRAVE_API_KEY=
FAL_KEY=
TRIGGER_SECRET_KEY=
