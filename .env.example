# ═══════════════════════════════════════════════════════════════════════
#  Next.js 앱 — Vercel 환경변수에 등록한다
# ═══════════════════════════════════════════════════════════════════════

# Supabase. anon 키는 브라우저에 공개되며, RLS가 유일한 방어선이다 (D-02)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 접근 게이트(GATE_USER / GATE_PASSWORD)는 7.7 에서 사라졌다 (2026-09-09).
# Vercel 환경변수에도 남아 있으면 지운다 — 읽는 코드가 없다.

# 계정 기능(가입·로그인·스크랩·월간 요약) 스위치 (7.0c).
# **1차 공개에서는 비워둔다** — 이메일 확인을 보낼 SMTP 가 아직 없다.
# 2차 공개에서 SMTP 와 콜백 라우트가 붙으면 1 로 켠다. `1` 외의 값은 전부 꺼짐이다
# TECHNOW_ACCOUNTS=1


# ═══════════════════════════════════════════════════════════════════════
#  Trigger.dev 파이프라인 전용
#
#  ⚠️ 아래 키는 절대 Vercel / Next.js 환경에 넣지 않는다 (CLAUDE.md §2.1).
#     NEXT_PUBLIC_ 접두사를 붙이는 순간 공개 키가 된다.
#     service_role 키가 앱으로 새면 RLS 방어선이 통째로 무의미해진다.
#
#  로컬에서는 .env.local 에 함께 두어도 되지만, 배포 시에는
#  Trigger.dev 대시보드의 환경변수에만 등록한다.
# ═══════════════════════════════════════════════════════════════════════

SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
BRAVE_API_KEY=
FAL_KEY=
TRIGGER_SECRET_KEY=


# ═══════════════════════════════════════════════════════════════════════
#  튜닝 값 (선택) — 로드맵 2.6
#
#  전부 기본값이 코드에 있고, 여기서 덮어쓸 수 있다.
#  Trigger.dev 환경변수는 재배포 없이 바뀌므로 캘리브레이션(2.8) 중에
#  배포를 기다리지 않아도 된다. 잘못된 값은 무시되고 기본값이 쓰인다.
#
#  아래 주석의 숫자는 **코드의 현재 기본값**이다. 기본값을 바꾸면 여기도 고친다.
#  값을 바꾸면 docs/RUBRIC.md 의 캘리브레이션 기록에 한 줄 남긴다.
# ═══════════════════════════════════════════════════════════════════════

# ── 선정 (src/config/thresholds.ts) ────────────────────────────────────
# TECHNOW_THRESHOLD_TOTAL=10          # 통과 최소 총점 (15점 만점)
# TECHNOW_MIN_AXIS=3                  # 모든 축이 이 값 이상이어야 통과
# TECHNOW_DAILY_CAP=5                 # 하루 발행 상한. 도달 목표가 아니라 천장 (D-46)
# TECHNOW_MAX_PAPERS_PER_DAY=2        # 상한 안에서 논문 토픽이 차지할 수 있는 최대 (D-57)
# TECHNOW_RESCORE_TOP_N=15            # 재채점할 상위 토픽 수. 상한의 3배 (D-19, D-46)
# TECHNOW_FOLLOW_UP_WINDOW_DAYS=7     # 그룹핑에 넣을 최근 발행 기사 기간
# TECHNOW_PENDING_TTL_DAYS=3          # pending 항목 폐기 기한 (D-01)
# TECHNOW_PROCESSED_RETENTION_DAYS=90 # processed 행 보존 기간

# ── 신선도 (src/config/filters.ts) ─────────────────────────────────────
# 두 값이 다른 층을 막는다. 피드에 오늘 실렸어도 다루는 연구는 작년 것일 수 있다
# TECHNOW_MAX_ITEM_AGE_DAYS=30        # 피드 항목이 이보다 오래되면 후보에서 뺀다
# TECHNOW_MAX_SOURCE_AGE_DAYS=30      # 출처 중 최소 하나는 이보다 최근이어야 한다

# ── 작성·번역 ──────────────────────────────────────────────────────────
# TECHNOW_FULL_REWRITE=1              # 근거 검증 실패 시 기사 전체를 다시 쓴다.
#                                     # 기본은 꺼짐(지적된 문장만 수정) — 전체
#                                     # 재작성은 비싸고 통과한 문장까지 새로 깨뜨린다.
#                                     # 비교 측정용으로만 켠다
# TECHNOW_MIN_HANGUL_RATIO=0.5        # 번역본이 한국어인지 판정하는 최소 한글 비율 (4.3a)


# ═══════════════════════════════════════════════════════════════════════
#  Rate limit (선택) — 로드맵 7.2
#
#  ⚠️ 위 튜닝 값과 달리 **Next.js 앱 쪽에서 읽는다.** Vercel 환경변수에 넣는다.
#  공개 후 실제 트래픽을 보고 재배포 없이 조일 수 있게 빼둔 것이다.
# ═══════════════════════════════════════════════════════════════════════

# TECHNOW_RATE_AUTH_MAX=10            # 로그인·가입 시도 횟수. IP 기준
# TECHNOW_RATE_AUTH_WINDOW=300        # 그 창의 길이 (초)
# TECHNOW_RATE_SCRAP_MAX=60           # 스크랩 토글 횟수. 로그인 사용자 기준
# TECHNOW_RATE_SCRAP_WINDOW=60        # 그 창의 길이 (초)
